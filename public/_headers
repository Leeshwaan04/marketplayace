/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Hashed build output never changes
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed static files: cache for a while, then revalidate
/media/*
  Cache-Control: public, max-age=604800
/logos/*
  Cache-Control: public, max-age=604800
/og-default.jpg
  Cache-Control: public, max-age=604800

# Company data shards change when the data is re-synced
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
